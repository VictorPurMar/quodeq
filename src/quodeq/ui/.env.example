# UI feature flags (read at build time)

# Use SSE-driven live updates for the evaluation dashboard instead of polling.
# Default on. Set to false to fall back to the polling path.
# The stream is same-origin only, like the rest of the UI: with QUODEQ_API_KEY
# set the server requires a bearer header on every request (including the
# page itself), which a browser cannot send, so the dashboard does not run in
# that mode with or without SSE.
VITE_USE_SSE_EVENTS=true

# Subscribe to live grade updates via the per-run SSE stream's scores.updated
# event. Default on since PR 4 (soak complete; legacy refetch path removed).
VITE_USE_LIVE_GRADES=true
